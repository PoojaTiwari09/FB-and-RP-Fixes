      "item": [
        {
          "name": "Get Coaching Filters",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-tenant-id",
                "value": "{{tenant_id}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/account-intelligence/coaching/filters",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "account-intelligence", "coaching", "filters"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Has periods and teams', () => {",
                  "  const body = pm.response.json().data || pm.response.json();",
                  "  pm.expect(body).to.have.property('periods');",
                  "  pm.expect(body).to.have.property('teams');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Coaching Activity",
