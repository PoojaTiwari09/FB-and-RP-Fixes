  "item": [
    {
      "name": "01 — Periods",
      "item": [
        {
          "name": "GET All Forecast Periods",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200/201', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
                  "pm.test('success = true', () => pm.expect(pm.response.json().success).to.be.true);",
                  "pm.test('data is array', () => pm.expect(pm.response.json().data).to.be.an('array'));",
                  "const periods = pm.response.json().data;",
                  "if (periods.length > 0) {",
                  "  pm.collectionVariables.set('PERIOD_ID', periods[0].id);",
                  "  console.log('Active period_id set to:', periods[0].id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "x-tenant-id", "value": "{{TENANT_ID}}" },
              { "key": "x-user-id",   "value": "{{MANAGER_ID}}" },
              { "key": "x-user-role", "value": "manager" }
            ],
            "url": { "raw": "{{BASE_URL}}/api/forecast/periods", "host": ["{{BASE_URL}}"], "path": ["api", "forecast","periods"] }
          }
        },
        {
          "name": "GET Reps in a Period",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200/201', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
                  "pm.test('data is array', () => pm.expect(pm.response.json().data).to.be.an('array'));",
                  "const reps = pm.response.json().data;",
                  "pm.test('Each rep has rep_id and rep_name', () => {",
                  "  if (reps.length > 0) {",
                  "    pm.expect(reps[0]).to.have.property('rep_id');",
                  "    pm.expect(reps[0]).to.have.property('rep_name');",
                  "    pm.collectionVariables.set('REP_ID', reps[0].rep_id);",
                  "  }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "x-tenant-id", "value": "{{TENANT_ID}}" },
              { "key": "x-user-id",   "value": "{{MANAGER_ID}}" },
              { "key": "x-user-role", "value": "manager" }
            ],
            "url": {
              "raw": "{{BASE_URL}}/api/forecast/periods/{{PERIOD_ID}}/reps",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "forecast","periods","{{PERIOD_ID}}","reps"]
            }
          }
        }
      ]
    },
