              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200/201', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
                  "pm.test('data is array', () => pm.expect(pm.response.json().data).to.be.an('array'));",
                  "const deals = pm.response.json().data;",
                  "pm.test('Deals have required fields', () => {",
                  "  if (deals.length > 0) {",
                  "    const d = deals[0];",
                  "    pm.expect(d).to.have.property('deal_id');",
                  "    pm.expect(d).to.have.property('best_case_state');",
                  "    pm.expect(d).to.have.property('commit_state');",
                  "    pm.expect(d.best_case_value).to.be.a('number');",
                  "    pm.expect(d.commit_value).to.be.a('number');",
                  "    pm.collectionVariables.set('DEAL_ID', d.deal_id);",
                  "    if (d.id) pm.collectionVariables.set('SUBMISSION_ID', d.id);",
                  "    console.log('DEAL_ID set to:', d.deal_id);",
                  "  }",
                  "});"
                ],
                "type": "text/javascript"
