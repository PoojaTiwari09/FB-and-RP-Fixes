{
  "info": {
    "name": "M06 — AI Revenue Predictor APIs (Curated)",
    "description": "Comprehensive E2E validation for AI Revenue Predictor containing specifically the 5 requested APIs with contract assertions.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. GET Team Board",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "const res = pm.response.json();",
              "pm.test('Matches Expected Frontend Contract', function () {",
              "    pm.expect(res.success).to.be.true;",
              "    const data = res.data;",
              "    pm.expect(data.teamName).to.exist;",
              "    pm.expect(data.quarter).to.exist;",
              "    pm.expect(data.aiProjection).to.be.a('number');",
              "    pm.expect(data.manualForecast).to.be.a('number');",
              "    pm.expect(data.mathData).to.be.an('object');",
              "    pm.expect(data.mathData.formula).to.exist;",
              "    pm.expect(data.activeDeals).to.be.an('array');",
              "    pm.expect(data.reps).to.be.an('array');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Tenant-ID",
            "value": "{{TENANT_ID}}"
          }
        ],
        "url": {
          "raw": "{{BASE_URL}}/api/v1/forecasting/team/board?periodId={{periodId}}",
          "host": [
            "{{BASE_URL}}"
          ],
          "path": [
            "api",
            "v1",
            "forecasting",
            "team",
            "board"
          ],
          "query": [
            {
              "key": "periodId",
              "value": "{{periodId}}"
            }
          ]
        }
      }
    },
