    {
      "name": "3. GET AI Prediction",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "const res = pm.response.json();",
              "pm.test('Matches Expected Frontend Contract', function () {",
              "    pm.expect(res.success).to.be.true;",
              "    const data = res.data;",
              "    pm.expect(data.period).to.be.an('object');",
              "    pm.expect(data.aiPrediction).to.be.an('object');",
              "    pm.expect(data.aiPrediction.predictedAmount).to.be.a('number');",
              "    pm.expect(data.aiPrediction.explainability).to.be.an('object');",
              "    pm.expect(data.aiPrediction.explainability.expectedDeals).to.be.an('object');",
              "    pm.expect(data.aiPrediction.explainability.closedWonDetails).to.be.an('object');",
              "    pm.expect(data.aiPrediction.explainability.pipelineByStage).to.be.an('array');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Tenant-ID",
