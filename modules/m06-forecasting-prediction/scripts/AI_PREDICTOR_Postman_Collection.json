    {
      "name": "4. GET Rep Drill Down View",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "const res = pm.response.json();",
              "pm.test('Matches Expected Frontend Contract', function () {",
              "    pm.expect(res.success).to.be.true;",
              "    const data = res.data;",
              "    pm.expect(data.repId).to.equal(pm.collectionVariables.get('repId'));",
              "    pm.expect(data.repName).to.exist;",
              "    pm.expect(data.aiProjection).to.be.a('number');",
              "    pm.expect(data.mathData).to.exist;",
              "    pm.expect(data.mathData.closedWon).to.exist;",
              "    pm.expect(data.activeDeals).to.be.an('array');",
              "});"
