{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "jsx": "react-jsx",
    "strict": false,
    "noEmit": true,
    "allowJs": true
  },
  "include": ["src", "components", "api", "lib", "types", "mocks"]
}
