  "item": [
    {
      "name": "Test Setup",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/test/health"
          }
        },
        {
          "name": "Seed Data",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.repId) pm.collectionVariables.set('repId', data.repId);",
                  "if (data.managerId) pm.collectionVariables.set('managerId', data.managerId);",
                  "if (data.orgId) pm.collectionVariables.set('orgId', data.orgId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/test/seed"
          }
        },
        {
          "name": "Generate Rep Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.token) pm.collectionVariables.set('token', data.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{repId}}\"\n}"
            },
            "url": "{{baseUrl}}/test/token"
          }
        },
        {
          "name": "Generate Manager Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{managerId}}\"\n}"
            },
            "url": "{{baseUrl}}/test/token"
          }
        },
        {
          "name": "Smoke Test",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/test/smoke"
          }
        }
      ]
    },
    {
      "name": "Sessions",
      "item": [
        {
          "name": "Get Voices",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/sessions/get-voices"
          }
        },
        {
          "name": "List My Sessions",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/sessions"
          }
        },
        {
          "name": "List Completed Sessions",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/sessions/my"
          }
        },
        {
          "name": "Start Session",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.sessionId) pm.collectionVariables.set('sessionId', data.sessionId);",
                  "if (data.id) pm.collectionVariables.set('sessionId', data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"scenarioId\": \"{{scenarioId}}\",\n  \"voiceId\": \"{{voiceId}}\"\n}"
            },
            "url": "{{baseUrl}}/sessions/start"
          }
        },
        {
          "name": "Get Session By Id",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/sessions/{{sessionId}}"
          }
        },
        {
          "name": "Send Message",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sessionId\": \"{{sessionId}}\",\n  \"message\": \"We help reduce ramp time and improve rep consistency. What matters most to you right now?\"\n}"
            },
            "url": "{{baseUrl}}/sessions/message"
          }
        },
        {
          "name": "Send Message Alias Text",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sessionId\": \"{{sessionId}}\",\n  \"text\": \"Can you share your biggest concern about budget or rollout effort?\"\n}"
            },
            "url": "{{baseUrl}}/sessions/message"
          }
        },
        {
          "name": "End Session",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sessionId\": \"{{sessionId}}\"\n}"
            },
            "url": "{{baseUrl}}/sessions/end"
          }
        },
        {
          "name": "Retry Session",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sessionId\": \"{{sessionId}}\"\n}"
            },
            "url": "{{baseUrl}}/sessions/retry"
          }
        }
      ]
    },
