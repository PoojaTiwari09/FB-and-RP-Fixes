{
  "info": {
    "_postman_id": "6bd46d50-9e0d-4d92-a9ff-9a0f52494fd3",
    "name": "M09 Coaching Training API",
    "description": "Postman collection for the m09-coaching-training NestJS service. Start with the Test folder to seed users/scenarios, generate a token, then use the Sessions, Scenarios, Analytics, Coaching, and Training requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4001/api"
    },
    {
      "key": "repId",
      "value": "rep-xyz"
    },
    {
      "key": "managerId",
      "value": "manager-abc"
    },
    {
      "key": "orgId",
      "value": "org-123"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "scenarioId",
      "value": "scenario-1"
    },
