datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma-client"
}

model ForecastPeriod {
  id            String   @id @default(uuid())
  tenantId      String
  name          String
  startDate     DateTime
  endDate       DateTime
  revenueTarget Float
  status        String   // 'open', 'closed', 'locked'
  isLocked      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  snapshots     AiForecastSnapshot[]
  submissions   ForecastSubmission[]

  @@map("forecast_periods")
}

model AiForecastSnapshot {
  snapshotId          String   @id @default(uuid())
  tenantId            String
  periodId            String
  predictedAmount     Float
  confidenceRangeLow  Float
  confidenceRangeHigh Float
  modelInputs         Json
  inputPipelineValue  Float?
  regionBreakdown     Json?    // { Americas: {...}, EMEA: {...}, APAC: {...} }
  computedAt          DateTime @default(now())
  idempotencyKey      String   @unique

  period              ForecastPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@map("ai_forecast_snapshots")
}

model PipelineCoverageMetrics {
  id                    String   @id @default(uuid())
  tenantId              String
  periodId              String
  openPipelineValue     Float
  weightedPipelineValue Float
  closedWonAmount       Float
  coverageRatio         Float
  computedAt            DateTime @default(now())

  @@map("pipeline_coverage_metrics")
}

model HistoricalConversionRate {
  id                 String   @id @default(uuid())
  tenantId           String
  fromStage          String
  toStage            String
  conversionRate     Float
  sampleSize         Int
  computedFromPeriod String
  periodName         String?  // e.g. 'Q1 FY26', 'Q4 FY25', 'Q2 FY25'
  computedAt         DateTime @default(now())

  @@map("historical_conversion_rates")
}

// Immutable append-only versioned submissions (no UPDATE/DELETE)
model ForecastSubmission {
  id                  String   @id @default(uuid())
  tenantId            String
  periodId            String
  repUserId           String
  lob                 String
  version             Int      @default(1)
  commitForecast      Float
  bestCaseForecast    Float?
  notes               String?
  status              String   // 'draft', 'submitted', 'approved', 'reopened', 'resubmitted'
  submittedAt         DateTime?
  // Manager action fields
  managerOverride     Float?
  managerComment      String?
  managerId           String?
  managerName         String?
  approvedAt          DateTime?
  reopenedAt          DateTime?
  overriddenAt        DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  period              ForecastPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@map("forecast_submissions")
}

model ForecastAuditLog {
  id                   String   @id @default(uuid())
  tenantId             String
  forecastSubmissionId String
  action               String
  actorId              String
  actorName            String?
  actorRole            String
  metadata             Json?
  createdAt            DateTime @default(now())

  @@map("forecast_audit_log")
}

model CrmDeal {
  id            String   @id @default(uuid())
  tenantId      String
  dealName      String
  stage         String
  amount        Float
  closeDate     DateTime
  probability   Float?
  isClosedWon   Boolean  @default(false)
  isClosedLost  Boolean  @default(false)
  region        String?  // 'Americas' | 'EMEA' | 'APAC'
  lob           String?
  repUserId     String?
  hubspotId     String?  // HubSpot deal ID for deduplication on re-sync
  lastActivityDate DateTime?
  riskReason    String?
  source        String   @default("seed")
  createdBy     String   @default("system")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("crm_deals")
}

model User {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  email     String   @unique
  password  String
  role      String   // 'sales_rep' | 'manager' | 'cro' | 'admin'
  repId     String?
  managerId String?
  region    String?
  teamName  String?
  createdAt DateTime @default(now())

  @@map("users")
}

model Quota {
  id        String   @id @default(uuid())
  tenantId  String
  periodId  String
  repUserId String
  amount    Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, periodId, repUserId])
  @@map("quotas")
}
