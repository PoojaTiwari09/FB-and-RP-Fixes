{
  "name": "@rri/database",
  "version": "1.0.0",
  "main": "index.js",
  "types": "index.d.ts",
  "scripts": {
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push --skip-generate",
    "db:generate": "prisma generate",
    "db:push:local": "prisma db push --schema prisma/schema.local-m06.prisma",
    "db:seed:m06": "npx tsx prisma/seed-m06.ts",
    "db:reset:local": "prisma db push --schema prisma/schema.local-m06.prisma --force-reset && npx tsx prisma/seed-m06.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3"
  },
  "devDependencies": {
    "prisma": "^5.22.0"
  }
}
