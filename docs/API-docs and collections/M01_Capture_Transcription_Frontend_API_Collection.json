              "pm.test(\"Status is 201 Created\", function () { pm.response.to.have.status(201); });",
              "pm.test(\"Response has call id\", function () {",
              "var r = pm.response.json();",
              "var d = r.data || r;",
              "if (d.data) d = d.data;",
              "var dbg = \" Response: \" + JSON.stringify(r);",
              "  var id = d.id || r.id;",
              "  pm.expect(id, \"Expected id to be a string.\" + dbg).to.be.a(\"string\");",
              "  pm.environment.set(\"call_id\", id);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Discovery Call - Acme Corp\",\n  \"callDate\": \"2026-06-11T14:10:49.582Z\",\n  \"callType\": \"outbound\",\n  \"callSource\": \"zoom\",\n  \"dealType\": \"Discovery\",\n  \"participants\": [\n    \"John Doe\",\n    \"Jane Smith\"\n  ],\n  \"callOwner\": \"33333333-3333-3333-3333-333333333333\"\n}",
