{
  "info": {
    "name": "R-Revenue Intelligence - Complete Role-Based API Testing",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Complete Postman Collection for testing Sales Rep and Manager roles with properly mapped endpoints. Login as role → Test role-specific APIs → Logout. All routes verified with /api/v1/ prefix."
  },
  "item": [
    {
      "name": "AUTHENTICATION - Login/Logout",
      "description": "Authentication endpoints for both roles",
      "item": [
        {
          "name": "1. LOGIN - Sales Rep (sarah.chen@relanto.com)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.expect(pm.response.code).to.equal(200);",
                  "});",
                  "",
                  "pm.test(\"Sales Rep login successful\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "    pm.expect(jsonData.data).to.have.property('accessToken');",
                  "    pm.expect(jsonData.data).to.have.property('refreshToken');",
                  "});",
                  "",
                  "pm.test(\"User role is SALES_REP\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data.user.role).to.equal('SALES_REP');",
                  "});",
                  "",
                  "// Store tokens and user info for Sales Rep",
                  "var jsonData = pm.response.json();",
                  "pm.collectionVariables.set('repAccessToken', jsonData.data.accessToken);",
                  "pm.collectionVariables.set('repRefreshToken', jsonData.data.refreshToken);",
                  "pm.collectionVariables.set('repUserId', jsonData.data.user.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"sarah.chen@relanto.com\",\n  \"password\": \"Password123!\",\n  \"tenantSlug\": \"relanto\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            }
          }
        },
