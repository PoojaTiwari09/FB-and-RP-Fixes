{
  "info": {
    "name": "M04 Deal Intelligence (Compliant)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "exec": [
          "",
          "pm.test('API follows standard response envelope', function () {",
          "    var jsonData = pm.response.json();",
          "    pm.expect(jsonData).to.have.property('success');",
          "    ",
          "    if (pm.response.code >= 200 && pm.response.code < 300) {",
          "        pm.expect(jsonData.success).to.be.true;",
          "        pm.expect(jsonData).to.have.property('data');",
          "    } else {",
          "        pm.expect(jsonData.success).to.be.false;",
          "        pm.expect(jsonData).to.have.property('error');",
          "    }",
          "});",
          "",
          "pm.test('Response includes requestId and timestamp metadata', function () {",
          "    var jsonData = pm.response.json();",
          "    if (jsonData.meta) {",
          "        pm.expect(jsonData.meta).to.have.property('requestId');",
          "        pm.expect(jsonData.meta).to.have.property('timestamp');",
          "    }",
          "});",
          ""
        ],
        "type": "text/javascript"
      }
    }
  ],
