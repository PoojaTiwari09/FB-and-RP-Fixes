    "board_tabs": [
        {
            "id": "tab_01",
            "board_id": "board_01",
            "label": "All Accounts",
            "order": 1,
            "filter_logic": {
                "operator": "AND",
                "conditions": []
            },
            "is_default": true
        },
        {
            "id": "tab_02",
            "board_id": "board_01",
            "label": "Renewal",
            "order": 2,
            "filter_logic": {
                "operator": "AND",
                "conditions": [
                    {
                        "field": "deal_type",
                        "op": "eq",
                        "value": "Renewal"
                    },
                    {
                        "field": "stage",
                        "op": "not_in",
                        "value": [
                            "Closed Won",
                            "Closed Lost"
                        ]
                    }
                ]
            },
            "is_default": false
        },
        {
            "id": "tab_03",
            "board_id": "board_01",
            "label": "Upsell",
            "order": 3,
            "filter_logic": {
                "operator": "AND",
                "conditions": [
                    {
                        "field": "deal_type",
                        "op": "in",
                        "value": [
                            "Upsell",
                            "Cross-sell"
                        ]
                    },
                    {
                        "field": "stage",
                        "op": "not_in",
                        "value": [
                            "Closed Won",
                            "Closed Lost"
                        ]
                    }
                ]
            },
            "is_default": false
        },
        {
            "id": "tab_04",
            "board_id": "board_01",
            "label": "At Risk",
            "order": 4,
            "filter_logic": {
                "operator": "OR",
                "conditions": [
                    {
                        "field": "last_activity_days",
                        "op": "gt",
                        "value": 21
                    },
                    {
                        "field": "ai_risk_score",
                        "op": "gte",
                        "value": 60
                    }
                ]
            },
            "is_default": false
        },
        {
            "id": "tab_05",
            "board_id": "board_02",
            "label": "All Accounts",
            "order": 1,
            "filter_logic": {
                "operator": "AND",
                "conditions": []
            },
            "is_default": true
        },
        {
            "id": "tab_06",
            "board_id": "board_02",
            "label": "Renewal",
            "order": 2,
            "filter_logic": {
                "operator": "AND",
                "conditions": [
                    {
                        "field": "deal_type",
                        "op": "eq",
                        "value": "Renewal"
                    },
                    {
                        "field": "stage",
                        "op": "not_in",
                        "value": [
                            "Closed Won",
                            "Closed Lost"
                        ]
                    }
                ]
            },
            "is_default": false
        },
        {
            "id": "tab_07",
            "board_id": "board_02",
            "label": "Churn Risk",
            "order": 3,
            "filter_logic": {
                "operator": "OR",
                "conditions": [
                    {
                        "field": "ai_risk_score",
                        "op": "gte",
                        "value": 65
                    },
                    {
                        "field": "last_activity_days",
                        "op": "gt",
                        "value": 30
                    }
                ]
            },
            "is_default": false
        },
        {
            "id": "tab_08",
            "board_id": "board_02",
            "label": "No Activity",
            "order": 4,
            "filter_logic": {
                "operator": "AND",
                "conditions": [
                    {
                        "field": "zero_activity_flag",
