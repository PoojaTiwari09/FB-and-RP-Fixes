            "label": "Active Deals",
            "order": 2,
            "filter_logic": {
                "operator": "AND",
                "conditions": [
                    {
                        "field": "stage",
                        "op": "not_in",
                        "value": [
                            "Closed Won",
                            "Closed Lost"
                        ]
                    }
                ]
            },
            "is_default": false
        },
        {
            "id": "tab_11",
            "board_id": "board_03",
            "label": "Stalled",
            "order": 3,
            "filter_logic": {
                "operator": "AND",
                "conditions": [
                    {
                        "field": "last_activity_days",
                        "op": "gt",
                        "value": 14
                    },
                    {
                        "field": "has_open_deal",
                        "op": "eq",
                        "value": true
                    }
                ]
            },
            "is_default": false
        },
        {
            "id": "tab_12",
            "board_id": "board_03",
            "label": "Closed Won",
            "order": 4,
            "filter_logic": {
                "operator": "AND",
                "conditions": [
                    {
                        "field": "stage",
                        "op": "eq",
                        "value": "Closed Won"
                    },
                    {
                        "field": "closed_days_ago",
                        "op": "lte",
                        "value": 90
                    }
                ]
            },
            "is_default": false
        }
