# R-Revenue Intelligence - Git Ignore Config

# Dependency directories
node_modules/
jspm_packages/
web_modules/

# Local env files (highly critical to ignore for security!)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# Build outputs
dist/
build/
.next/
out/
.turbo/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# Diagnostic reports
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Keystore / Secrets / Credentials
.doppler/
*.pem
*.key
*.pub

# IDEs and editors
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.specify/specs/spec-*.md.tmp

# OS files
.DS_Store
Thumbs.db

# SQLite / Local Database files
*.db
*.db-journal
*.sqlite
